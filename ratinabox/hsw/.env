# HSW Environment Configuration
# Copy this file to .env and update paths for your system

BASE_DIR=/home/tfl2886/projects/RatInABox

# Path to MATLAB position data file
MATLAB_FILE_PATH=${BASE_DIR}/fixtures/pos314.mat

